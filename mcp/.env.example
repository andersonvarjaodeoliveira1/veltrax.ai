# ClipGringa MCP server configuration
#
# Copy to .env (or set these in your MCP client config) and fill in values.

# --- Authentication (required for everything except the public discovery tools) ---
# Create a key in your ClipGringa account: Settings -> API Keys. Starts with "sk_".
CLIPGRINGA_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend selection ---
# Defaults to the official hosted instance. Override for self-hosting.
# CLIPGRINGA_API_URL=https://api.clipgringa.gringatools.com
# CLIPGRINGA_API_URL=http://localhost:8000

# --- Where downloaded/exported clips are written ---
# Defaults to ./clipgringa-downloads (relative to the server's working directory).
# CLIPGRINGA_DOWNLOAD_DIR=/absolute/path/to/clips

# --- HTTP timeout for non-download requests, in seconds (default 60) ---
# CLIPGRINGA_TIMEOUT=60

# --- Hosted MCP server mode ---
# Local MCP clients usually use stdio. For a hosted endpoint, run SSE:
# CLIPGRINGA_MCP_TRANSPORT=sse
# CLIPGRINGA_MCP_HOST=0.0.0.0
# CLIPGRINGA_MCP_PORT=9100
# CLIPGRINGA_MCP_PUBLIC_URL=https://mcp.clipgringa.gringatools.com
# CLIPGRINGA_MCP_REQUIRE_BEARER_AUTH=true

# --- Self-hosting auth alternatives (only if you are NOT using an API key) ---
# For a self-hosted backend you can authenticate with a user id directly:
#   * If the backend enforces signing (BACKEND_AUTH_SECRET set), provide both:
# CLIPGRINGA_USER_ID=your-user-id
# CLIPGRINGA_AUTH_SECRET=the-backend-BACKEND_AUTH_SECRET
#   * If the backend runs with ALLOW_UNSIGNED_BACKEND_AUTH=true, the user id alone is enough:
# CLIPGRINGA_USER_ID=your-user-id
