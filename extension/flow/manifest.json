{
  "manifest_version": 3,
  "name": "ClipGringa · Flow",
  "version": "1.0.5",
  "description": "Gera sozinho as imagens e os vídeos do seu pacote do ClipGringa dentro do seu projeto no Google Flow.",
  "permissions": [
    "storage",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/fx/*/tools/flow/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*/tools/flow/*"
      ],
      "js": [
        "content.js",
        "account.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://clipgringa.gringatools.com/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    },
    "default_title": "ClipGringa · Flow"
  }
}
