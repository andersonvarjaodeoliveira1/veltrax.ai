{
  "manifest_version": 3,
  "name": "ClipGringa · Flow",
  "version": "1.11.0",
  "description": "Gera sozinho as imagens e os vídeos do seu pacote do ClipGringa no Google Flow.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "debugger",
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/fx/*/tools/flow/*",
    "https://api.clipgringa.gringatools.com/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "https://clipgringa.gringatools.com/*",
    "https://labs.google/fx/*/tools/flow"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*/tools/flow/*",
        "https://labs.google/fx/*/tools/flow"
      ],
      "js": [
        "content.js",
        "account.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://clipgringa.gringatools.com/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    },
    "default_title": "ClipGringa · Flow"
  }
}