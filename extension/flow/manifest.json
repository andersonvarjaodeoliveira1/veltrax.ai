{
  "manifest_version": 3,
  "name": "ClipGringa · Flow",
  "version": "1.21.8",
  "description": "Cria sozinho as imagens e vídeos do seu pacote do ClipGringa no Google Flow, e os textos pela sua conta Gemini, ChatGPT ou Claude.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "debugger",
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/fx/*/tools/flow/*",
    "https://api.clipgringa.gringatools.com/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "https://clipgringa.gringatools.com/*",
    "https://labs.google/fx/*/tools/flow",
    "https://labs.google/fx/tools/flow",
    "https://labs.google/fx/tools/flow/*",
    "https://*.shopee.com.br/*",
    "https://shopee.com.br/*",
    "https://shp.ee/*",
    "https://shope.ee/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*/tools/flow/*",
        "https://labs.google/fx/*/tools/flow",
        "https://labs.google/fx/tools/flow",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": [
        "content.js",
        "account.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://clipgringa.gringatools.com/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "ai.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    },
    "default_title": "ClipGringa · Flow",
    "default_popup": "popup.html"
  }
}
