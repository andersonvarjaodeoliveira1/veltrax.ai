# ClipGringa - produção por subdomínio.
# Copie para .env e preencha. Nunca envie o .env para o GitHub.

# ---- Domínios (dois registros A apontando para o IP do servidor) ----
APP_DOMAIN=clipgringa.gringatools.com
API_DOMAIN=api.clipgringa.gringatools.com

NEXT_PUBLIC_APP_URL=https://clipgringa.gringatools.com
BETTER_AUTH_URL=https://clipgringa.gringatools.com
NEXT_PUBLIC_API_URL=https://api.clipgringa.gringatools.com
CORS_ORIGINS=https://clipgringa.gringatools.com
BETTER_AUTH_TRUSTED_ORIGINS=

# Link público do repositório com o código-fonte (exigido pela AGPL-3.0)
NEXT_PUBLIC_SOURCE_URL=https://github.com/SEU-USUARIO/clipgringa

# ---- Modo hospedado (cobrança ligada) ----
# SELF_HOST=false liga a cobrança por Stripe. Com true, o app é gratuito e sem limite.
SELF_HOST=false
FRONTEND_PORT=3107
FRONTEND_BUILD_TARGET=runner
NODE_ENV=production

# ---- Segredos: gere valores longos e aleatórios (openssl rand -hex 32) ----
BETTER_AUTH_SECRET=
BACKEND_AUTH_SECRET=
APP_SETTINGS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
ALLOW_UNSIGNED_BACKEND_AUTH=false

# ---- Transcrição e IA ----
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLY_AI_API_KEY=
LLM=google-gla:gemini-2.5-flash
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PEXELS_API_KEY=
BACKEND_CPU_ONLY=true

# ---- Limites ----
MAX_VIDEO_DURATION=5400
MAX_VIDEO_UPLOAD_BYTES=12000000000
PRO_PLAN_TASK_LIMIT=50
SCALE_PLAN_TASK_LIMIT=300
NEXT_PUBLIC_PRO_PRICE_MONTHLY=10
NEXT_PUBLIC_SCALE_PRICE_MONTHLY=50
NEXT_PUBLIC_PRO_PLAN_TASK_LIMIT=50
NEXT_PUBLIC_SCALE_PLAN_TASK_LIMIT=300

# ---- Stripe (somente com SELF_HOST=false) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SCALE_PRICE_ID=

# ---- E-mail (Amazon SES, opcional) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL="ClipGringa <no-reply@gringatools.com>"
